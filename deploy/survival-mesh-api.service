# API local de Survival Mesh (Capa 4).
# Instalar en /etc/systemd/system/ — ver deploy/README.md.
[Unit]
Description=Survival Mesh - API local (Capa 4)
After=network.target survival-mesh-rag.service
Wants=survival-mesh-rag.service

[Service]
Type=simple
WorkingDirectory=/opt/survival-mesh/api
ExecStart=/opt/survival-mesh/api/target/release/survival-mesh-api
Environment=SM_PORT=8080
Environment=SM_PWA_DIR=/opt/survival-mesh/pwa
Environment=SM_RAG_URL=http://127.0.0.1:8090
# Para inferencia real, apuntar a un llama-server:
# Environment=SM_LLM_URL=http://127.0.0.1:9001
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
