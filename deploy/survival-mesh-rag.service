# Servicio RAG de Survival Mesh (Capa 3).
# Instalar en /etc/systemd/system/ — ver deploy/README.md.
[Unit]
Description=Survival Mesh - servicio RAG (Capa 3)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/survival-mesh/rag
ExecStart=/opt/survival-mesh/.venv/bin/python3 service.py --db survival.db --port 8090
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
