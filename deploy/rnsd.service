# Daemon Reticulum (Capa 2).
# Requiere el paquete 'rns' instalado en el venv (pip install rns).
# Instalar en /etc/systemd/system/ — ver deploy/README.md y mesh/README.md.
[Unit]
Description=Reticulum Network Stack daemon (Capa 2)
After=network.target

[Service]
Type=simple
ExecStart=/opt/survival-mesh/rag/.venv/bin/rnsd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
